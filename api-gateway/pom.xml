<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>
    <parent>
        <groupId>org.springframework.boot</groupId>
        <artifactId>spring-boot-starter-parent</artifactId>
        <!--
            PHASE 0 (step 0.2): Boot 3.4.1 -> 4.0.9 (biggest jump of this phase).
            Why: the other four services already run Boot 4; the gateway was the only
            one left on Boot 3, and the 3.4 line no longer receives free (OSS)
            security fixes. Same Boot version everywhere = same library versions,
            same behaviour, one upgrade path.
        -->
        <!-- PHASE 0 (old): <version>3.4.1</version> -->
        <version>4.0.9</version>
        <relativePath/>
    </parent>
    <groupId>com.pm</groupId>
    <artifactId>api-gateway</artifactId>
    <version>0.0.1-SNAPSHOT</version>
    <name>api-gateway</name>
    <description>api-gateway</description>
    <properties>
        <java.version>21</java.version>
        <!--
            PHASE 0 (step 0.2): Spring Cloud is a "release train": a set of Spring Cloud
            projects (Gateway, Config, ...) tested together against ONE Boot line.
              2024.0.x -> Boot 3.4      2025.1.x -> Boot 4.0      2026.0.x -> Boot 4.1
            So with Boot 4.0.9 we must use 2025.1.x (brings Spring Cloud Gateway 5.0.4).
        -->
        <!-- PHASE 0 (old): <spring-cloud.version>2024.0.0</spring-cloud.version> -->
        <spring-cloud.version>2025.1.4</spring-cloud.version>
    </properties>
    <dependencies>
        <!--
            PHASE 0 (step 0.4): NEW - Spring Boot Actuator.
            Adds production endpoints under /actuator, most importantly
            /actuator/health. Docker (now) and Kubernetes (Phase 7) call it to ask
            "is this service really ready?" instead of only "is the process running?".
            In Phase 5 the same library exposes metrics for Prometheus.
        -->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-actuator</artifactId>
        </dependency>
        <!--
            PHASE 0 (step 0.2): the gateway starter was RENAMED.
            Spring Cloud Gateway now has two flavours:
              - spring-cloud-starter-gateway-server-webflux  (reactive, Netty) <- what we use
              - spring-cloud-starter-gateway-server-webmvc   (servlet, Tomcat)
            The old name "spring-cloud-starter-gateway" no longer exists in Gateway 5.x.
            Our gateway was always the reactive one (the filter returns Mono<Void>,
            uses ServerWebExchange and WebClient), so we pick the webflux flavour.
        -->
        <!-- PHASE 0 (old):
        <dependency>
            <groupId>org.springframework.cloud</groupId>
            <artifactId>spring-cloud-starter-gateway</artifactId>
        </dependency>
        -->
        <dependency>
            <groupId>org.springframework.cloud</groupId>
            <artifactId>spring-cloud-starter-gateway-server-webflux</artifactId>
        </dependency>
        <!--
            PHASE 0 (step 0.2): NEW.
            JwtValidationGatewayFilterFactory asks Spring for a WebClient.Builder to
            call auth-service /validate. In Boot 3 that builder came with WebFlux.
            Boot 4 split Spring Boot into smaller modules, and the WebClient
            auto-configuration now lives in its own module (spring-boot-webclient).
            Without this starter the gateway would fail at startup with
            "No qualifying bean of type WebClient.Builder".
        -->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-webclient</artifactId>
        </dependency>
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-test</artifactId>
            <scope>test</scope>
        </dependency>
    </dependencies>
    <dependencyManagement>
        <dependencies>
            <dependency>
                <groupId>org.springframework.cloud</groupId>
                <artifactId>spring-cloud-dependencies</artifactId>
                <version>${spring-cloud.version}</version>
                <type>pom</type>
                <scope>import</scope>
            </dependency>
        </dependencies>
    </dependencyManagement>
    <build>
        <plugins>
            <plugin>
                <groupId>org.springframework.boot</groupId>
                <artifactId>spring-boot-maven-plugin</artifactId>
            </plugin>
        </plugins>
    </build>
</project>
