<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>
    <parent>
        <groupId>org.springframework.boot</groupId>
        <artifactId>spring-boot-starter-parent</artifactId>
        <!--
            PHASE 0 (step 0.2): Boot 3.4.1 -> 4.0.9 (biggest jump of this phase).
            Why: the other four services already run Boot 4; the gateway was the only
            one left on Boot 3, and the 3.4 line no longer receives free (OSS)
            security fixes. Same Boot version everywhere = same library versions,
            same behaviour, one upgrade path.
        -->
        <!-- PHASE 0 (old): <version>3.4.1</version> -->
        <version>4.0.9</version>
        <relativePath/>
    </parent>
    <groupId>com.pm</groupId>
    <artifactId>api-gateway</artifactId>
    <version>0.0.1-SNAPSHOT</version>
    <name>api-gateway</name>
    <description>api-gateway</description>
    <properties>
        <java.version>21</java.version>
        <!--
            PHASE 0 (step 0.2): Spring Cloud is a "release train": a set of Spring Cloud
            projects (Gateway, Config, ...) tested together against ONE Boot line.
              2024.0.x -> Boot 3.4      2025.1.x -> Boot 4.0      2026.0.x -> Boot 4.1
            So with Boot 4.0.9 we must use 2025.1.x (brings Spring Cloud Gateway 5.0.4).
        -->
        <!-- PHASE 0 (old): <spring-cloud.version>2024.0.0</spring-cloud.version> -->
        <spring-cloud.version>2025.1.4</spring-cloud.version>
        <!-- PHASE 1 (step 1.3): empty default so "@{argLine}" below always resolves.
             Tools like JaCoCo (Phase 2) put their own agent into argLine. -->
        <argLine></argLine>
    </properties>
    <dependencies>
        <!--
            PHASE 0 (step 0.4): NEW - Spring Boot Actuator.
            Adds production endpoints under /actuator, most importantly
            /actuator/health. Docker (now) and Kubernetes (Phase 7) call it to ask
            "is this service really ready?" instead of only "is the process running?".
            In Phase 5 the same library exposes metrics for Prometheus.
        -->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-actuator</artifactId>
        </dependency>
        <!--
            PHASE 0 (step 0.2): the gateway starter was RENAMED.
            Spring Cloud Gateway now has two flavours:
              - spring-cloud-starter-gateway-server-webflux  (reactive, Netty) <- what we use
              - spring-cloud-starter-gateway-server-webmvc   (servlet, Tomcat)
            The old name "spring-cloud-starter-gateway" no longer exists in Gateway 5.x.
            Our gateway was always the reactive one (the filter returns Mono<Void>,
            uses ServerWebExchange and WebClient), so we pick the webflux flavour.
        -->
        <!-- PHASE 0 (old):
        <dependency>
            <groupId>org.springframework.cloud</groupId>
            <artifactId>spring-cloud-starter-gateway</artifactId>
        </dependency>
        -->
        <dependency>
            <groupId>org.springframework.cloud</groupId>
            <artifactId>spring-cloud-starter-gateway-server-webflux</artifactId>
        </dependency>
        <!--
            PHASE 0 (step 0.2): NEW.
            JwtValidationGatewayFilterFactory asks Spring for a WebClient.Builder to
            call auth-service /validate. In Boot 3 that builder came with WebFlux.
            Boot 4 split Spring Boot into smaller modules, and the WebClient
            auto-configuration now lives in its own module (spring-boot-webclient).
            Without this starter the gateway would fail at startup with
            "No qualifying bean of type WebClient.Builder".
        -->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-webclient</artifactId>
        </dependency>
        <!--
            PHASE 3 (step 3.1): NEW - the gateway becomes an OAuth2 "resource server".
            "Resource server" = an application that ACCEPTS access tokens (it does not issue
            them; Auth0 does). This starter brings Spring Security + the JWT (JOSE) library
            and auto-configures, from two properties in application.yml (issuer-uri,
            audiences), everything the old JwtValidation filter did by calling auth-service:
              1. read the issuer's /.well-known/openid-configuration -> find its JWKS URL
              2. download the issuer's PUBLIC keys once and cache them
              3. on every request: check signature, issuer, audience and expiry LOCALLY
            -> no network call per request any more. Our SecurityConfig decides WHICH paths
               need a token. Works for the reactive (WebFlux) gateway out of the box.
        -->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-security-oauth2-resource-server</artifactId>
        </dependency>
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-test</artifactId>
            <scope>test</scope>
        </dependency>
        <!--
            PHASE 3 (step 3.1): NEW - Spring Security test support (test scope only).
            GatewaySecurityTest signs its own tokens with a test key, so it needs no real
            issuer and no internet.
        -->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-security-oauth2-resource-server-test</artifactId>
            <scope>test</scope>
        </dependency>
        <!--
            PHASE 1 (step 1.1): NEW - test dependencies (all <scope>test</scope>: they are
            on the classpath only while tests compile/run, never in the jar or the image).
            No <version> on most of them: the Spring Boot 4.0.9 BOM manages them
            (Testcontainers 2.0.5, Awaitility 4.3.0, JUnit 6, Mockito 5, AssertJ 3).
            - spring-boot-starter-webflux-test: WebTestClient to call the running gateway in tests
              (Boot 4 moved it into its own test module). The stub auth/patient servers in the
              gateway tests use the JDK's built-in com.sun.net.httpserver - no extra library.
        -->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-webflux-test</artifactId>
            <scope>test</scope>
        </dependency>
    </dependencies>
    <dependencyManagement>
        <dependencies>
            <dependency>
                <groupId>org.springframework.cloud</groupId>
                <artifactId>spring-cloud-dependencies</artifactId>
                <version>${spring-cloud.version}</version>
                <type>pom</type>
                <scope>import</scope>
            </dependency>
        </dependencies>
    </dependencyManagement>
    <build>
        <plugins>
            <plugin>
                <groupId>org.springframework.boot</groupId>
                <artifactId>spring-boot-maven-plugin</artifactId>
            </plugin>
            <!--
                PHASE 1 (step 1.3): NEW - load Mockito as a Java agent for the tests.
                Mockito changes classes at runtime (to mock final classes / records) with an
                "inline mock maker". It used to attach itself to the running JVM; since
                Java 21 that self-attach is deprecated and inside the maven container it
                fails ("Could not self-attach to current VM") -> every mock test errors.
                The fix recommended by Mockito: start the test JVM with
                -javaagent:<mockito-core.jar>.
                1. maven-dependency-plugin "properties" goal defines a property per
                   dependency holding its jar path: ${org.mockito:mockito-core:jar}
                2. surefire passes it to the forked test JVM. "@{argLine}" keeps whatever
                   other plugins (JaCoCo in Phase 2) add.
                Versions of both plugins come from the Spring Boot parent.
            -->
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-dependency-plugin</artifactId>
                <executions>
                    <execution>
                        <goals>
                            <goal>properties</goal>
                        </goals>
                    </execution>
                </executions>
            </plugin>
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-surefire-plugin</artifactId>
                <configuration>
                    <argLine>@{argLine} -javaagent:${org.mockito:mockito-core:jar}</argLine>
                </configuration>
            </plugin>
            <!--
                PHASE 2 (step 2.1): NEW - JaCoCo test coverage report.
                - prepare-agent (before the tests): sets the Maven property argLine to
                  "-javaagent:jacoco.jar=...". Surefire's @{argLine} above (prepared in
                  Phase 1) inserts it, so JaCoCo and Mockito agents both run.
                - report (phase verify, i.e. "mvn verify"): writes
                  target/site/jacoco/index.html (for people) and jacoco.xml (for tools).
                Report only - no minimum %, so it never fails the build (a gate comes later).
                Classes generated from proto/ (packages billing, patient.events) are
                excluded: they are not our code, and would distort the numbers.
            -->
            <plugin>
                <groupId>org.jacoco</groupId>
                <artifactId>jacoco-maven-plugin</artifactId>
                <version>0.8.16</version>
                <configuration>
                    <excludes>
                        <exclude>billing/**</exclude>
                        <exclude>patient/events/**</exclude>
                    </excludes>
                </configuration>
                <executions>
                    <execution>
                        <id>prepare-agent</id>
                        <goals>
                            <goal>prepare-agent</goal>
                        </goals>
                    </execution>
                    <execution>
                        <id>report</id>
                        <phase>verify</phase>
                        <goals>
                            <goal>report</goal>
                        </goals>
                    </execution>
                </executions>
            </plugin>
        </plugins>
    </build>
</project>
