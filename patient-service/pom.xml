<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>
    <parent>
        <groupId>org.springframework.boot</groupId>
        <artifactId>spring-boot-starter-parent</artifactId>
        <!--
            PHASE 0 (step 0.2): 4.0.1 -> 4.0.9
            The parent POM is a "BOM" (Bill Of Materials): it decides the versions of
            every Spring/Jackson/Hibernate/Kafka/Flyway... library that Boot knows about.
            All services now use the SAME Boot version, so they share the same
            library versions and behave the same. 4.0.9 is the newest patch of the
            4.0 line (patch releases = bug/security fixes only, no breaking changes).
            We stay on 4.0.x and not 4.1 because the gateway's Spring Cloud release
            train for 4.1 (2026.0) is not GA yet.
        -->
        <!-- PHASE 0 (old): <version>4.0.1</version> -->
        <version>4.0.9</version>
        <relativePath/>
    </parent>
    <groupId>com.pm</groupId>
    <artifactId>patient-service</artifactId>
    <version>0.0.1-SNAPSHOT</version>
    <name>patient-service</name>
    <description>patient-service</description>
    <url/>
    <licenses>
        <license/>
    </licenses>
    <developers>
        <developer/>
    </developers>
    <scm>
        <connection/>
        <developerConnection/>
        <tag/>
        <url/>
    </scm>
    <properties>
        <java.version>21</java.version>
        <!-- PHASE 1 (step 1.3): empty default so "@{argLine}" below always resolves.
             Tools like JaCoCo (Phase 2) put their own agent into argLine. -->
        <argLine></argLine>
    </properties>
    <dependencies>
        <!--
            PHASE 0 (step 0.4): NEW - Spring Boot Actuator.
            Adds production endpoints under /actuator, most importantly
            /actuator/health. Docker (now) and Kubernetes (Phase 7) call it to ask
            "is this service really ready?" instead of only "is the process running?".
            In Phase 5 the same library exposes metrics for Prometheus.
        -->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-actuator</artifactId>
        </dependency>
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-data-jpa</artifactId>
        </dependency>
        <!--
            PHASE 0 (step 0.5): NEW - Flyway database migrations.
            Before, Hibernate changed the schema itself (ddl-auto=update). That cannot
            rename/drop columns safely, is not reviewable in a pull request and cannot
            be reproduced exactly on another database. With Flyway the schema is
            defined by versioned SQL files in src/main/resources/db/migration that
            run once each, in order, on startup.
            - spring-boot-starter-flyway: Boot 4 moved the Flyway auto-configuration
              into its own starter.
            - flyway-database-postgresql: since Flyway 10, support for each database
              is a separate module.
            Both versions come from the Boot BOM.
        -->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-flyway</artifactId>
        </dependency>
        <dependency>
            <groupId>org.flywaydb</groupId>
            <artifactId>flyway-database-postgresql</artifactId>
        </dependency>
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-validation</artifactId>
        </dependency>
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-webmvc</artifactId>
        </dependency>
        <!--
            PHASE 3 (step 3.2): NEW - patient-service becomes an OAuth2 "resource server"
            too (like the gateway in step 3.1, but servlet/WebMVC instead of reactive).
            The gateway already checked "is this token real?". patient-service checks it
            AGAIN and additionally "may this caller do THIS?" (permissions per endpoint).
            Why twice: defence in depth - port 4000 is reachable inside the network
            without the gateway, and a gateway bug must not open the data.
        -->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-security-oauth2-resource-server</artifactId>
        </dependency>
        <!--
            PHASE 3 (step 3.3): NEW - OAuth2 CLIENT: the opposite direction.
              resource server (above) = ACCEPTS tokens from callers
              client (this)           = GETS its own token from Auth0
            patient-service uses it to get a "service token" (client credentials grant)
            for its gRPC call to billing-service. It also caches the token until shortly
            before it expires, so Auth0 is not asked on every new patient.
        -->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-security-oauth2-client</artifactId>
        </dependency>
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-devtools</artifactId>
            <scope>runtime</scope>
            <optional>true</optional>
        </dependency>
        <dependency>
            <groupId>org.postgresql</groupId>
            <artifactId>postgresql</artifactId>
            <scope>runtime</scope>
        </dependency>
        <dependency>
            <groupId>org.projectlombok</groupId>
            <artifactId>lombok</artifactId>
            <optional>true</optional>
        </dependency>
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-data-jpa-test</artifactId>
            <scope>test</scope>
        </dependency>
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-validation-test</artifactId>
            <scope>test</scope>
        </dependency>
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-webmvc-test</artifactId>
            <scope>test</scope>
        </dependency>
        <!-- PHASE 3 (step 3.2): NEW - Spring Security test support (@WithMockUser,
             security in MockMvc). Test scope: never in the jar. -->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-security-oauth2-resource-server-test</artifactId>
            <scope>test</scope>
        </dependency>
        <dependency>
            <groupId>org.springdoc</groupId>
            <artifactId>springdoc-openapi-starter-webmvc-ui</artifactId>
            <!--
                PHASE 0 (step 0.2): springdoc is NOT managed by the Boot BOM, so we must
                pick a version ourselves. springdoc 2.x is built for Boot 3; springdoc
                3.0.x is built for Boot 4.0 (3.2.x targets Boot 4.1).
            -->
            <!-- PHASE 0 (old): <version>2.8.4</version> -->
            <version>3.0.3</version>
        </dependency>
        <dependency>
            <groupId>io.grpc</groupId>
            <artifactId>grpc-netty-shaded</artifactId>
            <version>1.69.0</version>
        </dependency>
        <dependency>
            <groupId>io.grpc</groupId>
            <artifactId>grpc-protobuf</artifactId>
            <version>1.69.0</version>
        </dependency>
        <dependency>
            <groupId>io.grpc</groupId>
            <artifactId>grpc-stub</artifactId>
            <version>1.69.0</version>
        </dependency>
        <dependency>
            <groupId>org.apache.tomcat</groupId>
            <artifactId>annotations-api</artifactId>
            <version>6.0.53</version>
            <scope>provided</scope>
        </dependency>
        <!--
            PHASE 0 (step 0.2): removed the net.devh gRPC Spring Boot starter.
            Why: that starter is for gRPC SERVERS (it scans for @GrpcService beans and
            starts a gRPC server) plus a client injection helper (@GrpcClient).
            patient-service is only a gRPC CLIENT and builds its channel by hand in
            BillingServiceGrpcClient using plain io.grpc classes, which come from the
            three grpc-* dependencies above. So the starter was unused weight.
            The starter is also built for Boot 3 and no longer maintained.
        -->
        <!-- PHASE 0 (old):
        <dependency>
            <groupId>net.devh</groupId>
            <artifactId>grpc-spring-boot-starter</artifactId>
            <version>3.1.0.RELEASE</version>
        </dependency>
        -->
        <dependency>
            <groupId>com.google.protobuf</groupId>
            <artifactId>protobuf-java</artifactId>
            <version>4.29.1</version>
        </dependency>
        <!--
            PHASE 0 (step 0.2): plain spring-kafka 3.3.0 -> spring-boot-starter-kafka
            Two problems with the old dependency:
              1. The hard-coded 3.3.0 is the Boot-3 generation of Spring Kafka. Boot 4
                 expects Spring Kafka 4.x. Hard-coding a version overrides the BOM and
                 mixes generations (works by luck, breaks on the next upgrade).
              2. In Boot 4 the Kafka AUTO-CONFIGURATION moved out of the core into its
                 own module, which only the starter brings in. With plain spring-kafka,
                 Boot creates no KafkaTemplate for you - that is one reason the project
                 needed the hand-written KafkaProducerConfig class.
            No <version> here: the Boot BOM picks the matching one (spring-kafka 4.0.8).
        -->
        <!-- PHASE 0 (old):
        <dependency>
            <groupId>org.springframework.kafka</groupId>
            <artifactId>spring-kafka</artifactId>
            <version>3.3.0</version>
        </dependency>
        -->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-kafka</artifactId>
        </dependency>
        <!--
            PHASE 1 (step 1.1): NEW - test dependencies (all <scope>test</scope>: they are
            on the classpath only while tests compile/run, never in the jar or the image).
            No <version> on most of them: the Spring Boot 4.0.9 BOM manages them
            (Testcontainers 2.0.5, Awaitility 4.3.0, JUnit 6, Mockito 5, AssertJ 3).
            - spring-boot-testcontainers: @ServiceConnection - Boot reads the URL/user/password of
              a container started by the test and configures the app with it (no properties).
            - testcontainers-*: starts REAL throwaway Postgres/Kafka in Docker for the test run.
              Testcontainers 2.x renamed its modules to "testcontainers-<module>".
            - spring-boot-starter-kafka-test: spring-kafka-test (KafkaTestUtils helpers to
              read/write test records).
            - awaitility: wait for something asynchronous (a Kafka message) with a timeout
              instead of Thread.sleep - makes async tests fast AND not flaky.
        -->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-testcontainers</artifactId>
            <scope>test</scope>
        </dependency>
        <dependency>
            <groupId>org.testcontainers</groupId>
            <artifactId>testcontainers-junit-jupiter</artifactId>
            <scope>test</scope>
        </dependency>
        <dependency>
            <groupId>org.testcontainers</groupId>
            <artifactId>testcontainers-postgresql</artifactId>
            <scope>test</scope>
        </dependency>
        <dependency>
            <groupId>org.testcontainers</groupId>
            <artifactId>testcontainers-kafka</artifactId>
            <scope>test</scope>
        </dependency>
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-kafka-test</artifactId>
            <scope>test</scope>
        </dependency>
        <dependency>
            <groupId>org.awaitility</groupId>
            <artifactId>awaitility</artifactId>
            <scope>test</scope>
        </dependency>
    </dependencies>

    <build>
        <extensions>
            <extension>
                <groupId>kr.motd.maven</groupId>
                <artifactId>os-maven-plugin</artifactId>
                <version>1.7.0</version>
            </extension>
        </extensions>
        <plugins>
            <plugin>
                <groupId>org.springframework.boot</groupId>
                <artifactId>spring-boot-maven-plugin</artifactId>
            </plugin>
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-compiler-plugin</artifactId>
                <configuration>
                    <annotationProcessorPaths>
                        <path>
                            <groupId>org.projectlombok</groupId>
                            <artifactId>lombok</artifactId>
                        </path>
                    </annotationProcessorPaths>
                </configuration>
            </plugin>
            <plugin>
                <groupId>org.xolstice.maven.plugins</groupId>
                <artifactId>protobuf-maven-plugin</artifactId>
                <version>0.6.1</version>
                <configuration>
                    <!--
                        PHASE 0 (step 0.3): read .proto files from the SHARED root folder
                        ../proto instead of this service's own src/main/proto.
                        <includes> limits which contracts this service compiles:
                        patient-service is a gRPC client of billing AND the Kafka producer, so it needs both.
                    -->
                    <protoSourceRoot>${project.basedir}/../proto</protoSourceRoot>
                    <includes>
                        <include>billing_service.proto</include>
                        <include>patient_event.proto</include>
                    </includes>
                    <protocArtifact>com.google.protobuf:protoc:3.25.5:exe:${os.detected.classifier}</protocArtifact>
                    <pluginId>grpc-java</pluginId>
                    <pluginArtifact>io.grpc:protoc-gen-grpc-java:1.68.1:exe:${os.detected.classifier}</pluginArtifact>
                </configuration>
                <executions>
                    <execution>
                        <goals>
                            <goal>compile</goal>
                            <goal>compile-custom</goal>
                        </goals>
                    </execution>
                </executions>
            </plugin>
            <!--
                PHASE 1 (step 1.3): NEW - load Mockito as a Java agent for the tests.
                Mockito changes classes at runtime (to mock final classes / records) with an
                "inline mock maker". It used to attach itself to the running JVM; since
                Java 21 that self-attach is deprecated and inside the maven container it
                fails ("Could not self-attach to current VM") -> every mock test errors.
                The fix recommended by Mockito: start the test JVM with
                -javaagent:<mockito-core.jar>.
                1. maven-dependency-plugin "properties" goal defines a property per
                   dependency holding its jar path: ${org.mockito:mockito-core:jar}
                2. surefire passes it to the forked test JVM. "@{argLine}" keeps whatever
                   other plugins (JaCoCo in Phase 2) add.
                Versions of both plugins come from the Spring Boot parent.
            -->
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-dependency-plugin</artifactId>
                <executions>
                    <execution>
                        <goals>
                            <goal>properties</goal>
                        </goals>
                    </execution>
                </executions>
            </plugin>
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-surefire-plugin</artifactId>
                <configuration>
                    <argLine>@{argLine} -javaagent:${org.mockito:mockito-core:jar}</argLine>
                </configuration>
            </plugin>
            <!--
                PHASE 2 (step 2.1): NEW - JaCoCo test coverage report.
                - prepare-agent (before the tests): sets the Maven property argLine to
                  "-javaagent:jacoco.jar=...". Surefire's @{argLine} above (prepared in
                  Phase 1) inserts it, so JaCoCo and Mockito agents both run.
                - report (phase verify, i.e. "mvn verify"): writes
                  target/site/jacoco/index.html (for people) and jacoco.xml (for tools).
                Report only - no minimum %, so it never fails the build (a gate comes later).
                Classes generated from proto/ (packages billing, patient.events) are
                excluded: they are not our code, and would distort the numbers.
            -->
            <plugin>
                <groupId>org.jacoco</groupId>
                <artifactId>jacoco-maven-plugin</artifactId>
                <version>0.8.16</version>
                <configuration>
                    <excludes>
                        <exclude>billing/**</exclude>
                        <exclude>patient/events/**</exclude>
                    </excludes>
                </configuration>
                <executions>
                    <execution>
                        <id>prepare-agent</id>
                        <goals>
                            <goal>prepare-agent</goal>
                        </goals>
                    </execution>
                    <execution>
                        <id>report</id>
                        <phase>verify</phase>
                        <goals>
                            <goal>report</goal>
                        </goals>
                    </execution>
                </executions>
            </plugin>
        </plugins>
    </build>

</project>
